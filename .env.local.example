# Supabase API keys (new publishable/secret system — anon/service_role are legacy).

# Publishable key (sb_publishable_…) — safe to expose; reads are gated by RLS
# (public read-only). Also set these two on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_…) — used ONLY by scripts/ingest to write data; bypasses
# RLS. Keep it local, never expose to the client or add it to Vercel.
SUPABASE_SECRET_KEY=sb_secret_xxx
